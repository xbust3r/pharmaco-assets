{
    "name": "pharmaco-assets",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "figma:assets": "node plugins/figma-assets.js",
        "font:subset": "node plugins/subset.js",
        "lint:pug": "markuplint \"src/**/*.pug\"",
        "lint:css": "stylelint \"src/**/*.css\" --fix --cache --cache-location .stylelintcache",
        "lint:js": "eslint \"src/**/*.js\" --fix --cache --cache-location .eslintcache",
        "lint": "run-p lint:pug lint:css lint:js",
        "validate": "node plugins/validate-assets.js",
        "validate:origen": "node plugins/validate-origen.js",
        "verify:render": "node plugins/verify-render.js",
        "optimize": "node plugins/convertWebp.js",
        "prebuild": "npm-run-all optimize --parallel lint validate",
        "build": "vite build",
        "postbuild": "node plugins/verify-render.js",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@markuplint/pug-parser": "^4.18.3",
        "@prettier/plugin-pug": "^3.4.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@vituum/vite-plugin-pug": "^2.0.1",
        "eslint": "^10.7.0",
        "glob": "^13.0.6",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "markuplint": "^4.18.3",
        "npm-run-all": "^4.1.5",
        "picocolors": "^1.1.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.5",
        "pug": "^3.0.4",
        "sharp": "^0.35.3",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^4.3.3",
        "vite": "^8.1.5",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vite-svg-sprite-wrapper": "^1.5.0",
        "vituum": "^2.0.2"
    },
    "browserslist": [
        "defaults"
    ],
    "packageManager": "pnpm@12.3.4"
}
