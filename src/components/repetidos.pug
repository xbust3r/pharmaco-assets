        h3(class="[margin-top:10px] weight-semibold [line-height:1.16] text-35 tablet:text-49 desktop:[margin-top:15px] desktop:[line-height:1.03] desktop:text-63 wide:text-77") !{p1}
        | #{' '}
        //- origen: c-section__content
        div(class="[margin-top:15px] [max-width:initial] desktop:[margin-top:34px] desktop:[max-width:80%]")
