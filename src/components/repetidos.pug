//- Mixins de componentes repetidos entre páginas (fase 4). Generados desde el marcado del origen:
//- cada uno sustituye a un bloque que aparece en 2 o más sitios; los textos y atributos son parámetros.

mixin repIcon(p0)
    //- origen: o-icon
    span(class="icon inline-block [line-height:.6] [margin-left:10px] text-16 desktop:text-20")
        svg(class="inline-block [font-size:inherit] [width:1em] [height:1em] [overflow:hidden] [stroke-width:0] [stroke:currentColor] [fill:currentColor]", aria-hidden='true')
            use(href=p0)

mixin repHeroPic(p0, p1, p2, p3, p4)
    //- origen: c-hero__pic
    picture(class="[width:360px] [max-width:1440px] [height:100%] block [margin-top:0] [margin-right:auto] [margin-bottom:0] [margin-left:auto] absolute [bottom:0] [left:0] [right:0] [z-index:0] tablet:[width:100%] tablet:[height:auto]")
        | #{' '}
        source(media="(min-width: 43.75rem)", srcset=p0, type="image/webp")
        | #{' '}
        source(srcset=p1, type="image/webp")
        | #{' '}
        //- origen: c-hero__img
        img(class="[width:100%] [height:auto] block", src=p2, alt=p3, aria-hidden="true", data-reveal=p4)
        | #{' '}

mixin repMediaBlockContent(p0, p1, p2, p3, p4)
    //- origen: c-media-block__content
    div(class="[width:initial] [margin-right:initial] [margin-left:initial] desktop:[width:536px] desktop:[margin-right:0] desktop:[margin-left:50px] wide:[margin-left:80px]")
