            //- origen: c-section__title
            h2(class="weight-semibold [line-height:1.6] text-16 text-blue tablet:text-17 desktop:text-18 wide:text-20") Portafolio
            | #{' '}
            //- origen: c-section__subtitle
            +repSectionSubtitle3()
            | #{' '}
            //- origen: c-section__content
            div(class="[margin-top:50px]")
                | #{' '}
