extends ../layouts/main-template

block title
    title Conoce nuestras soluciones | Pharmaco
block description
    meta(name='description', content="Pharmaco | Laboratorio digital de Marketing &amp; Software")
block content
    include ../components/repetidos
    | #{' '}
    //- origen: c-hero
    div(class="[padding-top:116px] [height:675px] relative bg-purple tablet:[height:745px] desktop:[padding-top:230px] desktop:[height:815px] wide:[height:890px]", data-hero="light-purple")
        | #{' '}
        //- origen: c-hero__content
        div(class="relative [z-index:1] [max-width:1440px] [margin-top:0] [margin-right:auto] [margin-bottom:0] [margin-left:auto]")
            | #{' '}
            div(class="wrapper [padding-right:30px] [padding-left:30px] [margin-right:auto] [margin-left:auto] [max-width:1302px]")
                | #{' '}
                //- origen: c-hero__subtitle
                h1(class="[margin-top:10px] weight-semibold [line-height:1.048] text-35 text-white [width:90%] [max-width:600px] tablet:text-49 desktop:[margin-top:15px] desktop:[line-height:1] desktop:text-63 wide:text-77") Conoce nuestras soluciones
                | #{' '}
                //- origen: c-hero__text
                +repHeroText("Algunos de nuestros proyectos realizados 👋")
                | #{' '}
                //- origen: c-hero__button
                div(class="[margin-top:38px] desktop:[margin-top:50px]")
                    | #{' '}
                    //- origen: c-button
                    a(class="inline-flex [align-items:center] [justify-content:center] [text-align:center] [height:48px] rounded-15 [padding-top:0] [padding-right:30px] [padding-bottom:0] [padding-left:30px] text-14 [text-decoration:none] weight-medium [line-height:1.2] [transition:all_.2s_ease,outline_0s] [box-shadow:none] focus:[transition:all_.2s_ease,outline_0s] focus:shadow-soft hover:[transition:all_.2s_ease,outline_0s] hover:shadow-soft bg-dark-purple text-white focus:bg-dark-purple-hover hover:bg-dark-purple-hover disabled:[opacity:.6] disabled:[cursor:not-allowed] wide:[height:64px] wide:rounded-20 wide:text-18", href="contactanos.html")
                        | Contáctanos#{' '}
                        //- origen: o-icon
                        +repIcon("/src/assets/images/sprite.svg#icon-arrow-right")
                        | #{' '}
                    | #{' '}
                | #{' '}
            | #{' '}
        | #{' '}
        //- origen: c-hero__pic
        +repHeroPic("/src/assets/images/components/hero/hero-portafolio-lg.webp, /src/assets/images/components/hero/hero-portafolio-lg@2x.webp 2x", "/src/assets/images/components/hero/hero-portafolio-sm.webp, /src/assets/images/components/hero/hero-portafolio-sm@2x.webp 2x", "/src/assets/images/components/hero/hero-portafolio-lg.webp", "", "fade-in")
