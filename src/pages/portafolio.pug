                        | #{' '}
                        //- origen: o-list-bare__item
                        +repListBareItem4("fade-right", "100", "portafolio-detalle.html", "alt", "/src/assets/images/components/projects/project-1.webp", "portafolio-detalle.html", "Branding Venturi", "Lorem ipsum")
                        | #{' '}
                        //- origen: o-list-bare__item
                        +repListBareItem4("fade-right", "150", "portafolio-detalle.html", "alt", "/src/assets/images/components/projects/project-1.webp", "portafolio-detalle.html", "Campaña Iveco", "Lorem ipsum")
                        | #{' '}
                        //- origen: o-list-bare__item
                        +repListBareItem4("fade-left", "50", "portafolio-detalle.html", "alt", "/src/assets/images/components/projects/project-1.webp", "portafolio-detalle.html", "Modelado 3D", "Lorem ipsum")
                        | #{' '}
                        //- origen: o-list-bare__item
                        +repListBareItem4("fade-left", "100", "portafolio-detalle.html", "alt", "/src/assets/images/components/projects/project-1.webp", "portafolio-detalle.html", "Branding Venturi", "Lorem ipsum")
                        | #{' '}
                        //- origen: o-list-bare__item
                        +repListBareItem4("fade-left", "150", "portafolio-detalle.html", "alt", "/src/assets/images/components/projects/project-1.webp", "portafolio-detalle.html", "Campaña Iveco", "Lorem ipsum")
                        | #{' '}
                    | #{' '}
                    //- origen: c-button__wrapper
                    div(class="flex [align-items:flex-start] [justify-content:center] [flex-wrap:wrap] [margin-top:34px] [margin-right:0] [margin-bottom:0] [margin-left:0] desktop:[margin-top:54px]")
                        | #{' '}
                        //- origen: c-button
                        a(class="inline-flex [align-items:center] [justify-content:center] [text-align:center] [height:48px] rounded-15 [padding-top:0] [padding-right:30px] [padding-bottom:0] [padding-left:30px] text-14 [text-decoration:none] weight-medium [line-height:1.2] [transition:all_.2s_ease,outline_0s] [box-shadow:none] focus:[transition:all_.2s_ease,outline_0s] focus:shadow-soft hover:[transition:all_.2s_ease,outline_0s] hover:shadow-soft bg-blue text-white focus:bg-blue-hover hover:bg-blue-hover disabled:[opacity:.6] disabled:[cursor:not-allowed] wide:[height:64px] wide:rounded-20 wide:text-18", href="#")
                            | Ver más#{' '}
                            span(class="[border:0]! [clip:rect(0_0_0_0)]! [clip-path:inset(50%)]! [height:1px]! [margin-top:-1px]! [margin-right:-1px]! [margin-bottom:-1px]! [margin-left:-1px]! [overflow:hidden]! [padding-top:0]! [padding-right:0]! [padding-bottom:0]! [padding-left:0]! absolute! [white-space:nowrap]! [width:1px]!") trabajo del portafolio
                            | #{' '}
